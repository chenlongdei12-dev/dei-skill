{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content evidence claim",
  "type": "object",
  "required": ["claim_id", "statement", "claim_type", "scope", "sample_size", "confidence", "limitations", "status"],
  "properties": {
    "claim_id": {"type": "string"},
    "statement": {"type": "string"},
    "claim_type": {"enum": ["descriptive_fact", "observed_correlation", "mechanism_inference", "hypothesis", "prediction", "strategic_choice"]},
    "metric": {"type": ["string", "null"]},
    "scope": {"type": ["string", "object"]},
    "sample_size": {"type": ["integer", "object"]},
    "data_period": {"type": ["object", "null"]},
    "supporting_work_ids": {"type": "array", "items": {"type": "string"}},
    "counterexample_work_ids": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["low", "medium", "high"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["observed", "proposed", "testing", "supported", "rejected", "inconclusive", "fatigued"]},
    "next_test": {"type": ["string", "null"]}
  }
}
